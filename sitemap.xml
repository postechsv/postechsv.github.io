---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- if p.sitemap == false or p.redirect_to -%}{%- continue -%}{%- endif -%}
{%- assign ext = p.url | split: '.' | last -%}
{%- if ext == 'css' or ext == 'xml' or ext == 'txt' or ext == 'json' or p.url contains '404' -%}{%- continue -%}{%- endif %}
  <url><loc>{{ p.url | remove: 'index.html' | absolute_url }}</loc></url>
{%- endfor -%}
{%- for t in site.researchtopics -%}
{%- if t.hidden == true -%}{%- continue -%}{%- endif %}
  <url><loc>{{ t.url | absolute_url }}</loc></url>
{%- endfor %}
  <url><loc>{{ '/kmbae/' | absolute_url }}</loc></url>
</urlset>
